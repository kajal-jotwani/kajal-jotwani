---
/*
 * Resume.astro — the static piano-roll layout (DOM only, no canvas yet).
 *
 * Lanes = rows; x-axis = year. Each entry is an absolutely-positioned block
 * inside its lane track, placed by pre-computed left%/width% from the data
 * loader. Overlapping entries stack into sub-rows so nothing is hidden.
 *
 * Two-column grid per row: a fixed label gutter + a 1fr track. Every row uses
 * the same gutter width so the year axis and all lane tracks share one x-origin.
 * Geometry is pure CSS variables (--left, --width, --row) — Stage 3's canvas
 * reuses the same numbers, so the two renderings stay in lockstep.
 */
import { content } from "../data/content.js";

const { lanes, axis } = content;
const laneColor = (i) => `var(--lane-${(i % 4) + 1})`;
const fmtYear = (y) => String(y);
---

<section class="resume" aria-label="Career timeline">
  <div class="resume__ruler" aria-hidden="true">
    <div class="resume__ruler-label"></div>
    <div class="resume__ruler-track">
      <span class="resume__ruler-line"></span>
      {
        axis.ticks.map((y) => (
          <span
            class="resume__tick"
            style={`left: ${axis.tickPct(y)}%`}
          >
            <span class="resume__tick-mark" />
            <span class="resume__tick-label">{fmtYear(y)}</span>
          </span>
        ))
      }
    </div>
  </div>

  <ol class="resume__lanes">
    {
      lanes.map((lane, i) => (
        <li
          class="resume__lane"
          style={`--lane-color: ${laneColor(i)}; --sub-rows: ${lane.subRows || 1}`}
        >
          <div class="resume__lane-label">
            <span class="resume__lane-name">{lane.label}</span>
            <span class="resume__lane-instrument">{lane.instrument}</span>
          </div>

          <div class="resume__lane-track">
            <span class="resume__lane-rule" />
            {lane.entries.map((e) => (
              <article
                class="resume__block"
                style={`--left: ${e._leftPct}%; --width: ${e._widthPct}%; --row: ${e._subRow}`}
                aria-label={`${e.title} — ${e.org}`}
              >
                <div class="resume__block-bar" />
                <h3 class="resume__block-title">{e.title}</h3>
                <p class="resume__block-org">{e.org}</p>
                <p class="resume__block-summary">{e.summary}</p>
                {e.tags.length > 0 && (
                  <ul class="resume__block-tags">
                    {e.tags.map((t) => (
                      <li class="resume__tag">{t}</li>
                    ))}
                  </ul>
                )}
                <span class="resume__block-years" aria-hidden="true">
                  {fmtYear(e.start)}
                  {e.end !== e.start ? `–${fmtYear(e.end)}` : ""}
                </span>
              </article>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .resume {
    --gutter: clamp(4.5rem, 12vw, 7.5rem);
    --row-h: clamp(4.2rem, 7vw, 5.6rem);
    --row-gap: 0.5rem;
    --block-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  /* Year axis ----------------------------------------------------------- */
  .resume__ruler,
  .resume__lane {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    align-items: stretch;
  }

  .resume__ruler-track,
  .resume__lane-track {
    position: relative;
    min-height: var(--row-h);
  }

  .resume__ruler-track {
    min-height: 1.75rem;
  }

  .resume__ruler-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: var(--border);
  }

  .resume__tick {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .resume__tick-mark {
    width: 1px;
    height: 5px;
    background: var(--border-strong);
  }

  .resume__tick-label {
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Lane rows ---------------------------------------------------------- */
  .resume__lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .resume__lane {
    position: relative;
  }

  .resume__lane-label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    padding-right: 1rem;
    border-right: 1px solid var(--border);
  }

  .resume__lane-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.02em;
  }

  .resume__lane-instrument {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lane-color);
    opacity: 0.85;
  }

  .resume__lane-track {
    height: calc(var(--sub-rows) * (var(--row-h) + var(--row-gap)));
  }

  .resume__lane-rule {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent calc(var(--row-h) - 1px),
      var(--border) calc(var(--row-h) - 1px)
    );
    background-size: 100% calc(var(--row-h) + var(--row-gap));
    opacity: 0.5;
    pointer-events: none;
  }

  /* Entry blocks ------------------------------------------------------- */
  .resume__block {
    position: absolute;
    left: var(--left, 0);
    width: var(--width, 10%);
    top: calc(var(--row, 0) * (var(--row-h) + var(--row-gap)));
    height: var(--row-h);
    padding: 0.6rem 0.8rem 0.55rem;
    border-radius: var(--block-radius);
    background: color-mix(in srgb, var(--lane-color) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--lane-color) 32%, var(--border));
    overflow: hidden;
    min-width: 7rem;
    /* leave room for the inner left accent bar */
    transition: transform var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease);
  }

  .resume__block-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--lane-color);
    border-radius: var(--block-radius) 0 0 var(--block-radius);
  }

  .resume__block-title {
    font-size: 0.92rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--fg);
    margin-left: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .resume__block-org {
    font-size: 0.74rem;
    color: var(--muted);
    margin-left: 0.35rem;
    margin-top: 0.05rem;
  }

  .resume__block-summary {
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--fg-dim);
    margin-top: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .resume__block-tags {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .resume__tag {
    font-size: 0.62rem;
    line-height: 1.4;
    padding: 0.06rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--lane-color) 14%, transparent);
    color: color-mix(in srgb, var(--lane-color) 60%, var(--fg));
    border: 1px solid color-mix(in srgb, var(--lane-color) 22%, transparent);
  }

  .resume__block-years {
    position: absolute;
    right: 0.5rem;
    bottom: 0.35rem;
    font-size: 0.62rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  /* Tighten blocks that are too narrow to hold prose */
  .resume__block:has(.resume__block-summary:empty) .resume__block-summary {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .resume__block {
      transition: none;
    }
  }

  /* On narrow viewports the absolute-positioned timeline gets cramped.
     We don't flatten to a list yet (canvas arrives next stage), but we let
     the gutter shrink and blocks scroll if needed. */
  @media (max-width: 560px) {
    .resume__block-summary,
    .resume__block-tags {
      display: none;
    }
    .resume__block-title {
      font-size: 0.8rem;
    }
  }
</style>
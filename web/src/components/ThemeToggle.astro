---
/*
 * ThemeToggle.astro — a single accessible button.
 * Wiring (persistence + theme:change emission) lives in src/scripts/main.js,
 * which looks for every [data-theme-toggle] and binds click handlers.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle light and dark theme"
  aria-pressed="false"
  title="Toggle theme"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="currentColor" />
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="12" y1="2.5" x2="12" y2="5" />
      <line x1="12" y1="19" x2="12" y2="21.5" />
      <line x1="2.5" y1="12" x2="5" y2="12" />
      <line x1="19" y1="12" x2="21.5" y2="12" />
      <line x1="5.2" y1="5.2" x2="6.9" y2="6.9" />
      <line x1="17.1" y1="17.1" x2="18.8" y2="18.8" />
      <line x1="5.2" y1="18.8" x2="6.9" y2="17.1" />
      <line x1="17.1" y1="6.9" x2="18.8" y2="5.2" />
    </g>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path
      d="M20 13.2A8 8 0 1 1 10.8 4a6.4 6.4 0 0 0 9.2 9.2z"
      fill="currentColor"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--fg-dim);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      background var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  .icon {
    grid-area: 1 / 1;
    transition: opacity var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  /* Dark (default): show the moon (action = go light). */
  .icon--sun {
    opacity: 0;
    transform: scale(0.6) rotate(-90deg);
  }
  .icon--moon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  /* Light: show the sun (action = go dark). */
  :global([data-theme="light"]) .icon--sun {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
  :global([data-theme="light"]) .icon--moon {
    opacity: 0;
    transform: scale(0.6) rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon,
    .theme-toggle {
      transition: none;
    }
  }
</style>
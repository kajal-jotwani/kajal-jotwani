---
/*
 * Sequencer.astro — wraps the canvas + controls and hydrates sequencer.js.
 *
 * No React: this is a "vanilla island." Astro's `client:visible` directive only
 * applies to framework components, so we mirror its behavior ourselves —
 * sequencer.js defers all work behind an IntersectionObserver so the canvas
 * doesn't hydrate until it scrolls near the viewport (first paint stays fast).
 *
 * The pre-computed geometry + pre-rendered markdown travel as a JSON blob in a
 * <script type="application/json"> tag, so the client needs no data fetch and
 * no markdown library. `<` and `>` are escaped in the serialization to keep the
 * blob safe inside the document (no </script> injection from user content).
 */
import { content } from "../data/content.js";

const dataJson = JSON.stringify(content)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e");
---

<section class="sequencer" data-sequencer aria-label="Career sequencer">
  <div class="sequencer__controls">
    <button type="button" class="sequencer__play" data-play aria-label="Play my career">
      ▶ Play my career
    </button>
    <span class="sequencer__hint" aria-hidden="true">
      arrow keys navigate · enter opens details
    </span>
  </div>

  <div
    class="sequencer__stage"
    data-stage
    tabindex="0"
    role="application"
    aria-label="Career timeline. Use arrow keys to move between entries, Enter to open details."
  >
    <canvas class="sequencer__canvas" aria-hidden="true"></canvas>
  </div>

  <p class="sequencer__sr" data-sr-live aria-live="polite"></p>

  <script type="application/json" data-sequencer-data set:html={dataJson} />

  <script>
    import { initSequencer } from "../scripts/sequencer.js";
    initSequencer(document.querySelector("[data-sequencer]"));
  </script>
</section>

<style>
  .sequencer {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .sequencer__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .sequencer__play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    transition: transform var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease), filter var(--speed) var(--ease);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  }
  .sequencer__play:hover {
    filter: brightness(1.05);
    box-shadow: 0 6px 20px -8px var(--accent);
  }
  .sequencer__play:active {
    transform: scale(0.97);
  }
  .sequencer__play[data-state="playing"] {
    color: var(--fg);
    background: transparent;
    border-color: var(--border-strong);
    box-shadow: none;
  }

  .sequencer__hint {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .sequencer__stage {
    position: relative;
    width: 100%;
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border);
    overflow: hidden;
    outline: none;
  }
  .sequencer__stage:focus-visible {
    box-shadow: var(--focus-ring);
  }
  .sequencer__canvas {
    display: block;
    width: 100%;
  }

  .sequencer__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 560px) {
    .sequencer__hint {
      display: none;
    }
  }
</style>
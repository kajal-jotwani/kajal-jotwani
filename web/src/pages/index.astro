---
import "../styles/theme.css";
import "../styles/base.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import content from "../../content.json";

const { name, tagline, links } = content.meta;

// Inline head bootstrap — sets data-theme before first paint to avoid a flash.
// localStorage wins → else prefers-color-scheme → else dark. main.js owns the
// toggle, persistence, and theme:change events after this.
const themeBootstrap = `(function(){try{var k='kj-theme';var s=localStorage.getItem(k);var m=window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches;var t=s||(m?'light':'dark');document.documentElement.setAttribute('data-theme',t);}catch(e){}})();`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="description"
      content={`${name} — ${tagline}. A playable-score portfolio.`}
    />
    <title>{name} — {tagline}</title>
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__mark" href="/">{name}</a>
        <ThemeToggle />
      </div>
    </header>

    <main id="main" class="container hero">
      <p class="hero__eyebrow muted">A playable score</p>
      <h1 class="hero__name">{name}</h1>
      <p class="hero__tagline">{tagline}</p>

      <nav class="hero__links" aria-label="Links">
        {
          links?.github && (
            <a href={links.github} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          )
        }
        {
          links?.linkedin && (
            <a href={links.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
          )
        }
        {
          links?.site && (
            <a href={links.site} target="_blank" rel="noopener noreferrer">
              Site
            </a>
          )
        }
      </nav>

      <p class="hero__placeholder muted">
        <em>The sequencer arrives in the next stage — your career, playable.</em>
      </p>
    </main>

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
  }

  .site-header__mark {
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .site-header__mark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-block: clamp(5rem, 14vh, 9rem) 6rem;
  }

  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
  }

  .hero__name {
    margin-block: 0.2rem 0;
  }

  .hero__tagline {
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    color: var(--fg-dim);
    max-width: 52ch;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.4rem;
  }

  .hero__links a {
    color: var(--fg-dim);
    font-weight: 500;
  }
  .hero__links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .hero__placeholder {
    margin-top: 2.6rem;
    font-size: 0.9rem;
  }
</style>